# ─────────────────────────────────────────────────────────────
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini hech qachon GitHub'ga yuklamang!
# ─────────────────────────────────────────────────────────────

# Faqat VPS + Docker uchun (docker-compose.yml): domen va baza paroli
DOMAIN="admire.uz"
DB_PASSWORD="bu-yerga-uzun-tasodifiy-parol"

# Ma'lumotlar bazasi (PostgreSQL). Docker'da bu qiymat avtomatik almashtiriladi.
DATABASE_URL="postgresql://admire:PAROL@127.0.0.1:5432/admire?schema=public"

# Saytning to'liq manzili (oxirida / belgisi bo'lmasin)
APP_URL="http://localhost:3000"

# Bitta o'quvchi akkaunti bir vaqtda nechta qurilmada ochiq bo'lishi mumkin
SESSION_MAX_DEVICES=2
# Sessiya necha kun faol turadi
SESSION_TTL_DAYS=30

# Birinchi admin (npm run db:seed). Parolni bo'sh qoldirsangiz, avtomatik yaratiladi
# va terminalda bir marta ko'rsatiladi.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PHONE="+998900000000"
SEED_ADMIN_PASSWORD=""

# Bunny Stream (video). README'dagi "Video xizmatini ulash" bo'limiga qarang.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOST=""
BUNNY_STREAM_TOKEN_KEY=""

# Bunny Storage (PDF va audio materiallar)
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_API_KEY=""
BUNNY_STORAGE_HOST="storage.bunnycdn.com"

# Telegram bot (yangi ariza haqida xabar)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
