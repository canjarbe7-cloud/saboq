// Saboq — ma'lumotlar bazasi sxemasi.
// O'zgartirgandan keyin: npm run db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum CourseSection {
  LISTENING
  READING
  WRITING
  SPEAKING
  GRAMMAR
  VOCABULARY
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum VideoStatus {
  NONE
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MaterialType {
  PDF
  AUDIO
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum ApplicationStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  phone              String
  /// Har doim kichik harflarda saqlanadi.
  username           String     @unique
  passwordHash       String
  role               Role       @default(STUDENT)
  status             UserStatus @default(ACTIVE)
  /// Admin bergan vaqtinchalik parol — birinchi kirishda o'zgartirish majburiy.
  mustChangePassword Boolean    @default(true)
  note               String?
  /// Profildagi qo'shimcha ma'lumotlar — o'quvchi o'zi to'ldiradi.
  birthDate          DateTime?  @db.Date
  gender             Gender?
  region             String?
  email              String?
  /// Telegram username, "@" belgisisiz.
  telegram           String?
  groupId            String?
  group              Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions     Session[]
  enrollments  Enrollment[]
  progress     LessonProgress[]
  activityDays ActivityDay[]
  achievements UserAchievement[]
  auditLogs    AuditLog[]
  attendance   AttendanceRecord[]

  @@index([role, status])
  @@index([groupId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cookie'dagi tokenning SHA-256 hash'i. Tokenning o'zi bazada saqlanmaydi.
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, lastSeenAt])
  @@index([expiresAt])
}

/// Brute-force himoyasi uchun login urinishlari.
model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

/// Umumiy rate-limit hisoblagichi (masalan, ariza formasi).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Group {
  id                 String              @id @default(cuid())
  name               String              @unique
  note               String?
  createdAt          DateTime            @default(now())
  users              User[]
  attendanceSessions AttendanceSession[]
}

model Course {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  section     CourseSection
  description String        @default("")
  status      PublishStatus @default(DRAFT)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  modules     Module[]
  enrollments Enrollment[]

  @@index([status, position])
}

model Module {
  id        String        @id @default(cuid())
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  status    PublishStatus @default(DRAFT)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id          String        @id @default(cuid())
  moduleId    String
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  status      PublishStatus @default(DRAFT)
  position    Int           @default(0)
  /// Video xizmatidagi (Bunny Stream) video identifikatori.
  videoId     String?
  videoStatus VideoStatus   @default(NONE)
  durationSec Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  materials Material[]
  progress  LessonProgress[]

  @@index([moduleId, position])
}

model Material {
  id         String       @id @default(cuid())
  lessonId   String
  lesson     Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title      String
  type       MaterialType
  /// Fayl omboridagi kalit (yo'l). Ochiq havola emas.
  storageKey String
  fileName   String
  sizeBytes  Int
  position   Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([lessonId, position])
}

/// O'quvchiga kurs ochilgani. Kelajakda to'lov (Payment) shu yozuvga bog'lanadi.
model Enrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// null — muddatsiz.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Video to'xtagan joy (soniya).
  positionSec Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId, updatedAt])
}

/// O'quvchi dars qilgan kunlar ("5 kun ketma-ket" uchun).
model ActivityDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date

  @@id([userId, day])
}

model UserAchievement {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nishon kodi — ro'yxati src/server/services/achievements.ts da.
  code     String
  earnedAt DateTime @default(now())

  @@id([userId, code])
}

/// Bitta dars uchun davomat: admin ekranga QR kod chiqaradi, o'quvchilar kabinetdan skaner qiladi.
model AttendanceSession {
  id        String    @id @default(cuid())
  /// null — guruhga bog'lanmagan (barcha faol o'quvchilar).
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Guruh keyin o'chirilsa ham tarixda nomi qoladi.
  title     String
  /// QR kodni imzolash uchun tasodifiy kalit. Brauzerga hech qachon yuborilmaydi.
  secret    String
  startedAt DateTime  @default(now())
  /// null — davomat hali ochiq (skaner qilish mumkin).
  closedAt  DateTime?

  records AttendanceRecord[]

  @@index([startedAt])
  @@index([groupId, startedAt])
}

/// Yopilgan davomatda har bir o'quvchi uchun yozuv bor (PRESENT yoki ABSENT);
/// ochiq davomatda yozuvi yo'q o'quvchi "hali kelmagan" hisoblanadi.
model AttendanceRecord {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  method    AttendanceMethod
  markedAt  DateTime          @default(now())

  @@id([sessionId, userId])
  @@index([userId, markedAt])
}

/// Admin panelda tahrirlanadigan sayt kontenti: har bo'lim (ustozlar, natijalar, aloqa …) bitta yozuv.
/// Tuzilishi src/lib/site-content.ts dagi sxemalar bilan tekshiriladi.
model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// "Kursga yozilish" arizasi.
model Application {
  id        String            @id @default(cuid())
  name      String
  phone     String
  level     String
  status    ApplicationStatus @default(NEW)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
